{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "LEDs: Compilar",
            "type": "process",
            "command": "${userHome}/.platformio/penv/bin/pio",
            "args": ["run", "-e", "leds"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "LEDs: Cargar al ESP32",
            "type": "process",
            "command": "${userHome}/.platformio/penv/bin/pio",
            "args": ["run", "-e", "leds", "-t", "upload"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        },
